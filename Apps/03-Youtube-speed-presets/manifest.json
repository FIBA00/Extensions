{
	"manifest_version": 3,
	"name": "YouTube Speed Presets",
	"version": "1.0",
	"description": "Auto-apply playback speed per YouTube channel.",
	"permissions": ["storage", "activeTab", "scripting"],
	"host_permissions": ["*://*.youtube.com/*"],
	"action": {
		"default_popup": "src/popup/popup.html",
		"default_title": "YouTube Speed Presets"
	},
	"icons": {
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"content_scripts": [
		{
			"matches": ["*://*.youtube.com/*"],
			"js": ["src/content.js"],
			"run_at": "document_end"
		}
	]
}
